#!/bin/bash
KB_ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
set -e
# Pre-commit hook: AGENT.md 变更→验证 tag+log
# 非交互模式——检查不通过直接阻断

if git diff --cached --name-only | grep -q "AGENT.md"; then
  ERRORS=0
  
  # Check recent git tag (within 10 min) —— 读 refs/tags mtime（tag 创建时间，非 commit 时间）
  recent_tag=$(git tag --sort=-creatordate | head -1)
  tag_time=0
  if [ -n "$recent_tag" ] && [ -f "$KB_ROOT/.git/refs/tags/$recent_tag" ]; then
    tag_time=$(stat -c %Y "$KB_ROOT/.git/refs/tags/$recent_tag" 2>/dev/null || echo 0)
  fi
  now=$(date +%s)

  if [ "$tag_time" = "0" ] || [ $((now - tag_time)) -gt 600 ]; then
    echo "❌ G层修改未打tag (最近tag: ${recent_tag:-无}, ${tag_time:-无时间})"
    echo "   请先执行: git tag vX.X-pre-xxx"
    ERRORS=$((ERRORS+1))
  fi
  
  # Check log.md also staged
  if ! git diff --cached --name-only | grep -q "log.md"; then
    echo "❌ G层修改未同步log.md"
    echo "   请先追加log记录"
    ERRORS=$((ERRORS+1))
  fi
  
  if [ $ERRORS -gt 0 ]; then
    echo ""
    echo "⚠️  G层防误操作: $ERRORS 项未通过，commit已阻断"
    echo "   修复以上问题后重新 commit"
    exit 1
  fi
  
  echo "✅ G层修改验证: tag+log已就位"
fi

# 版本一致性检查（每次 commit 都跑）
bash "$KB_ROOT"/framework/core/hooks/gate/version-check.sh
if [ $? -ne 0 ]; then
  echo "   请同步设计方案版本号后重新 commit"
  exit 1
fi

# kb-* 平铺校验（Warning）—— 防止 Claude 内部 skill 一级入口回归丢失
KB_SKILL_MISSING=$(python "$KB_ROOT/engine/scripts/sync-skills-to-claude.py" --check 2>/dev/null | grep -c "❌" || true)
if [ "$KB_SKILL_MISSING" -gt 0 ]; then
  echo ""
  echo "🟡 kb-* 平铺校验：Claude 内部 skill 一级入口缺失"
  echo "   请执行: python engine/scripts/sync-skills-to-claude.py"
fi

# ===== 机制2：检查前置（分档阻断）=====

# 计数漂移检查（全量，阻断）—— 机制1
COUNTS=$(python "$KB_ROOT/engine/scripts/check-counts.py" --repo "$KB_ROOT" --json 2>/dev/null || true)
COUNTS_STATUS=$(echo "$COUNTS" | python -c "import sys,json; print(json.load(sys.stdin).get('status','pass'))" 2>/dev/null || echo "error")
if [ "$COUNTS_STATUS" = "fail" ]; then
  echo ""
  echo "❌ 计数漂移（机制1）：文档声明的计数与实际不符"
  echo "$COUNTS" | python -c "
import sys,json
d=json.load(sys.stdin)
for m in d.get('mismatches',[]):
    print('   %s:%s count:%s 声明%s 实际%s' % (m['file'],m['line'],m['key'],m['declared'],m['actual']))
" 2>/dev/null
  echo "   请更新 <!-- count:xxx=N --> 锚点后重新 commit"
  exit 1
fi

# 脚本引用失效检查（全量，阻断）—— 机制2
SCRIPTREFS=$(python "$KB_ROOT/engine/scripts/check-script-refs.py" --repo "$KB_ROOT" --json 2>/dev/null || true)
SCRIPTREFS_STATUS=$(echo "$SCRIPTREFS" | python -c "import sys,json; print(json.load(sys.stdin).get('status','pass'))" 2>/dev/null || echo "error")
if [ "$SCRIPTREFS_STATUS" = "fail" ]; then
  echo ""
  echo "❌ 脚本引用失效：引用了不存在的脚本文件"
  echo "$SCRIPTREFS" | python -c "
import sys,json
d=json.load(sys.stdin)
for i in d.get('issues',[]):
    print('   %s:%s -> %s' % (i['script'],i['line'],i['ref']))
" 2>/dev/null
  echo "   请修正脚本引用后重新 commit"
  exit 1
fi

# 断链检查（增量，Warning）—— 只查本次变更文件
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' | tr '\n' ' ')
if [ -n "$CHANGED_FILES" ]; then
  BROKEN_STATUS=$(python "$KB_ROOT/engine/scripts/check-links.py" --repo "$KB_ROOT" --mode broken --files $CHANGED_FILES --json 2>/dev/null | python -c "import sys,json; print(json.load(sys.stdin).get('status','pass'))" 2>/dev/null || echo "error")
  if [ "$BROKEN_STATUS" = "fail" ]; then
    echo ""
    echo "🟡 断链警告（增量）：本次变更文件中有断链，建议修复（本次未阻断）"
    python "$KB_ROOT/engine/scripts/check-links.py" --repo "$KB_ROOT" --mode broken --files $CHANGED_FILES 2>/dev/null | grep '❌' | head -5
  fi
fi

# 护栏F: 硬编码路径检测（Warning 模式，暂不阻断）
HARDCODED=$(python "$KB_ROOT/engine/scripts/check-hardcoded-paths.py" --repo "$KB_ROOT" --json 2>/dev/null || true)
HARDCODED_STATUS=$(echo "$HARDCODED" | python -c "import sys,json; print(json.load(sys.stdin).get('status','pass'))" 2>/dev/null || echo "error")
if [ "$HARDCODED_STATUS" = "fail" ]; then
  echo ""
  echo "🟡 护栏F: 检测到硬编码绝对路径（建议修复，本次未阻断）"
  echo "$HARDCODED" | python -c "
import sys,json
d=json.load(sys.stdin)
for i in d.get('issues',[])[:5]:
    print(f'   {i}')
" 2>/dev/null
fi

exit 0
